# Eufy cloud account credentials (the same login you use in the Eufy Security app).
EUFY_USERNAME="my@email.com"
EUFY_PASSWORD="my-password"

# ISO country / language for the Eufy cloud region. IMPORTANT: this MUST match
# the country your Eufy app account is registered in, or the device list comes
# back empty (login still succeeds). e.g. US, IN, DE, GB, CA, AU.
EUFY_COUNTRY="US"
EUFY_LANGUAGE="en"

# Set true to auto-accept pending family/guest invitations (needed if the
# cameras are owned by another account and shared with yours).
EUFY_ACCEPT_INVITATIONS="false"

# Where the library caches its session token + cloud data. First login may
# require a 2FA/captcha code (entered in the browser on the viewer page); after
# that the token in this dir is reused so you won't be prompted again.
EUFY_PERSIST_DIR="./persist"

# Optional: comma-separated device serial numbers to show, in order.
# Leave empty to auto-pick the first two cameras on the account.
EUFY_CAMERA_SERIALS=""

# Port for the viewer (kept distinct from cam-frontend's 3030).
EUFY_VIEWER_PORT="3040"

# eufy-security-client log level: trace|debug|info|warn|error. Default info.
# Use debug if login fails and you need the full reason from the cloud API.
EUFY_LOG_LEVEL="info"
