# ============================================================================
# Shared environment for BOTH dashboards. Copy to .env and fill in.
#   - cam-frontend/server.js (Wyze, :3030) loads this file (../.env)
#   - eufy/server.js         (Eufy,  :3040) loads this file (../.env)
# Relative paths (PERSIST_PATH, EUFY_PERSIST_DIR) resolve against each app's
# own directory, since each server runs from its own folder.
# ============================================================================

# ----- Wyze (cam-frontend, port 3030) --------------------------------------
USERNAME="my@email.com"
PASSWORD="my-password"
# API key + key id from https://developer-api-console.wyze.com/ (API Key Management)
KEY_ID="my-key-id"
API_KEY="my-api-key"
# Directory where Wyze login tokens are cached (wyze-<uuid>.json).
# In Docker this is overridden to /data and should be a mounted volume.
PERSIST_PATH="./scratch"
LOG_LEVEL="none"
API_LOG_ENABLED="false"
# Port the Wyze dashboard listens on.
VIEWER_PORT="3030"

# Where the cam-frontend dashboard reaches the Eufy viewer process to proxy its
# API + video WebSocket. Must match EUFY_VIEWER_PORT below.
EUFY_BASE_URL="http://localhost:3040"

# ----- Eufy (eufy, port 3040) ----------------------------------------------
# Same login you use in the Eufy Security app.
EUFY_USERNAME="my@email.com"
EUFY_PASSWORD="my-password"
# ISO country / language for the Eufy cloud region.
EUFY_COUNTRY="US"
EUFY_LANGUAGE="en"
# Where the library caches its session token + cloud data. First login may
# require a 2FA/captcha code (entered from the dashboard); after that the token
# in this dir is reused so you won't be prompted again.
EUFY_PERSIST_DIR="./persist"
# Optional: comma-separated device serials to show, in order. Empty = first two.
EUFY_CAMERA_SERIALS=""
# Port the Eufy viewer process listens on (proxied through :3030).
EUFY_VIEWER_PORT="3040"
