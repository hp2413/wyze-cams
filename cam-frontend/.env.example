# Wyze account credentials
USERNAME="my@email.com"
PASSWORD="my-password"

# API key + key id from https://developer-api-console.wyze.com/ (API Key Management)
KEY_ID="my-key-id"
API_KEY="my-api-key"

# Directory where login tokens are cached (wyze-<uuid>.json).
# In Docker this is set to /data and should be a mounted volume so you don't
# re-authenticate on every restart.
PERSIST_PATH="./"

# Port the dashboard listens on (defaults to 3030)
VIEWER_PORT="3030"

# Optional logging
LOG_LEVEL="none"
API_LOG_ENABLED="false"

# docker-wyze-bridge sidecar — used for live-channel controls the cloud API
# can't perform on newer cameras (e.g. the Wyze Cam v4 / HL_CAM4 spotlight).
# Run the bridge (mrlt8/wyze-bridge) with your Wyze creds; see README.
BRIDGE_URL="http://localhost:5000"
# Bridge REST API key. Set this to the bridge's WB_API value, or leave blank
# if you start the bridge with WB_AUTH=false (fine for localhost-only use).
BRIDGE_API=""
# Only set if you override the bridge's URI_SEPARATOR (default "-").
# URI_SEPARATOR="-"
